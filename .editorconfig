# Domyślny styl formatowania dla projektu, zgodny z konwencją Google Java Style Guide
# (wedle której wtyczka checkstyle sprawdza kod)

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.java]
indent_style = space
indent_size = 2
tab_width = 2
continuation_indent_size = 2
ij_java_class_count_to_use_import_on_demand = 999
ij_java_names_count_to_use_import_on_demand = 999

ij_java_static_class_count_to_use_import_on_demand = 999
ij_java_static_names_count_to_use_import_on_demand = 999

ij_java_imports_layout = java.**;javax.**;;org.**;;com.**;;lombok.**;;
